# --- API server ---------------------------------------------------------------
# Signs the session token the screens carry. Any long random string; changing it
# signs everybody out.
JWT_SECRET=

# Cloud SQL (database "lakshmi", schema "pos"). On Cloud Run set
# INSTANCE_CONNECTION_NAME and leave DB_HOST/DB_PORT empty; on a laptop run the
# Cloud SQL Auth Proxy and use 127.0.0.1:5433.
INSTANCE_CONNECTION_NAME=
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=lakshmi
DB_USER=
DB_PASSWORD=

# Staff passwords live in Firebase Auth, not in our database. The API key is the
# project's public browser key (it can only ask "is this password right?"), and
# creating a login or resetting a password uses the service account instead.
GCP_PROJECT_ID=lakshmi-sarees
FIREBASE_API_KEY=
# Staff with no email of their own get <username>@this-domain for Firebase.
STAFF_EMAIL_DOMAIN=pos.lakshmisarees.in

# Bill reading and the colour-sheet splitter (Python service).
OCR_SERVICE_URL=

NODE_ENV=development
PORT=3001

# --- screens (Vite) -----------------------------------------------------------
VITE_API_URL=/api
