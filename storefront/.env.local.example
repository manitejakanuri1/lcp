# Base URL for store_functions (see ../store_functions). Point this at the local
# dev-server (`npm run dev` in store_functions) or, later, wherever the functions
# are actually deployed. NEXT_PUBLIC_ because some calls happen client-side
# (search, filters, live price/stock).
NEXT_PUBLIC_CLOUD_FUNCTIONS_BASE_URL=http://localhost:8090

# Used to build absolute URLs in robots.txt / sitemap.xml.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (deployed DB). Use your instance's API URL and anon key.
# NEXT_PUBLIC_ because the browser client also needs these. The anon key is safe
# to expose; never put the service_role key in a NEXT_PUBLIC_ var.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Production only: each 2nd-gen function has its own URL. JSON map of function name -> URL
# (from `npm run deploy` output). Names not listed fall back to NEXT_PUBLIC_CLOUD_FUNCTIONS_BASE_URL/<name>.
# NEXT_PUBLIC_CLOUD_FUNCTION_URLS={"nav-get":"https://nav-get-xxxx-el.a.run.app"}
