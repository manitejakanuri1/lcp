{
  "name": "store-functions",
  "version": "0.1.0",
  "private": true,
  "description": "Cloud functions data layer for the Lakshmi Sarees storefront (Next.js app never talks to a DB/CMS directly).",
  "main": "lib/index.js",
  "scripts": {
    "dev": "tsx watch src/dev-server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "gcp-build": "npm run build",
    "deploy": "bash scripts/deploy.sh"
  },
  "dependencies": {
    "@google-cloud/cloud-sql-connector": "^1.12.0",
    "@google-cloud/functions-framework": "^3.4.2",
    "express": "^4.19.2",
    "firebase-admin": "^14.5.0",
    "jose": "^5.10.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "@types/pg": "^8.23.1",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20"
  }
}
